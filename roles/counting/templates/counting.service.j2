[Unit]
Description=Counting Flask API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory={{ counting_app_dir }}
ExecStart={{ counting_app_dir }}/venv/bin/gunicorn --workers 1 --bind 0.0.0.0:{{ counting_port }} app:app
Restart=always
RestartSec=3
User=root
Group=root

[Install]
WantedBy=multi-user.target
