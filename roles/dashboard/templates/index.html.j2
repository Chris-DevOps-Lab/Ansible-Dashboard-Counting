<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Ansible DevOps Dashboard</title>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      min-height: 100vh;
      font-family: Arial, sans-serif;
      background: #f4f6f8;
      display: grid;
      place-items: center;
      color: #17202a;
    }
    .card {
      width: min(92vw, 620px);
      background: white;
      border-radius: 18px;
      padding: 36px;
      box-shadow: 0 12px 32px rgba(0,0,0,.10);
      text-align: center;
    }
    h1 { margin-top: 0; }
    .label { color: #667085; margin-bottom: 8px; }
    #count {
      font-size: 72px;
      font-weight: 700;
      margin: 12px 0 24px;
    }
    .status {
      margin: 16px 0 24px;
      font-size: 14px;
    }
    .actions {
      display: flex;
      gap: 12px;
      justify-content: center;
      flex-wrap: wrap;
    }
    button {
      border: 0;
      border-radius: 10px;
      padding: 12px 18px;
      cursor: pointer;
      font-size: 15px;
    }
    .primary { background: #111827; color: white; }
    .secondary { background: #e5e7eb; color: #111827; }
    code { background: #f2f4f7; padding: 2px 6px; border-radius: 5px; }
  </style>
</head>
<body>
  <main class="card">
    <h1>Ansible DevOps Dashboard</h1>
    <p class="label">Application Request Count</p>
    <div id="count">-</div>

    <div class="actions">
      <button class="primary" onclick="incrementCount()">Increment Count</button>
      <button class="secondary" onclick="resetCount()">Reset</button>
    </div>

    <p id="status" class="status">Ready</p>
    <p><small>Dashboard: <code>{{ ansible_host }}:{{ dashboard_port }}</code></small></p>
  </main>

<script>
  const countEl = document.getElementById("count");
  const statusEl = document.getElementById("status");

  async function incrementCount() {
    statusEl.textContent = "Calling counting API...";
    try {
      const response = await fetch("/api/count");
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      const data = await response.json();
      countEl.textContent = data.count;
      statusEl.textContent = "Counting API is healthy";
    } catch (error) {
      statusEl.textContent = `Error: ${error.message}`;
    }
  }

  async function resetCount() {
    statusEl.textContent = "Resetting...";
    try {
      const response = await fetch("/api/reset", { method: "POST" });
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      const data = await response.json();
      countEl.textContent = data.count;
      statusEl.textContent = "Counter reset";
    } catch (error) {
      statusEl.textContent = `Error: ${error.message}`;
    }
  }
</script>
</body>
</html>
